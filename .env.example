# Puerto HTTP
PORT=3000
# Cada cuánto se refrescan las tasas (expresión cron). Por defecto cada 10 minutos.
RATES_REFRESH_CRON=*/10 * * * *
# Cantidad de anuncios P2P de Binance usados para calcular la tasa (se descartan extremos)
BINANCE_ADS_SAMPLE=10
# Orígenes permitidos para CORS (coma separada) o * para todos
CORS_ORIGINS=*
